# Copiar como `.env` y completar. No commitear el `.env` real (está en .gitignore).
# Este archivo NO debe contener valores reales.

# ── Entorno ──────────────────────────────────────────────────────────────────
# 'desarrollo' expone /docs, /redoc y /openapi.json; 'produccion' los deshabilita.
CRM_ENTORNO=desarrollo

# ── JWT (REQUERIDO) ───────────────────────────────────────────────────────────
# Clave de firma de los access tokens. La aplicación NO arranca sin ella y
# rechaza el valor de prueba histórico 'test-secret-key-for-ci'.
# Generar una nueva con: openssl rand -base64 48
ACCESS_TOKEN_SECRET_KEY=
ACCESS_TOKEN_ALGORITHM=HS256

# Duración del access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── Refresh token ────────────────────────────────────────────────────────────
REFRESH_TOKEN_EXPIRE_DIAS=1
REFRESH_TOKEN_REUSE_GRACE_SEGUNDOS=30

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DB_PORT=5432
POSTGRES_DB=crm_db
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=

# ── Scheduler de alertas ─────────────────────────────────────────────────────
CRM_INICIAR_SCHEDULER=True
CRM_SCHEDULER_INTERVALO_MINUTOS=1

# ── WebSocket de notificaciones ──────────────────────────────────────────────
# Orígenes permitidos (separados por coma). El navegador no aplica CORS al
# handshake de un WebSocket: el origen se valida contra esta lista.
CRM_ORIGENES_PERMITIDOS=http://localhost:3000
# Vida útil del ticket que autoriza la conexión (no es el JWT de sesión)
CRM_WS_TICKET_TTL_SEGUNDOS=60
# Periodicidad del "ping" del servidor para mantener viva la conexión
CRM_WS_HEARTBEAT_SEGUNDOS=30

# ── Auditoría ────────────────────────────────────────────────────────────────
# Solo estos peers directos pueden fijar X-Forwarded-For / X-Real-IP
CRM_PROXY_CONFIABLES=127.0.0.1,::1,172.17.0.0/16,172.19.0.0/16
# Apaga la captura de eventos de auditoría sin tocar código
CRM_AUDITORIA_HABILITADA=True
